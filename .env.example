APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Use true em local/staging e false em produção.
NEXT_PUBLIC_AUTH_SIGNUP_ENABLED=true
AUTH_SIGNUP_ENABLED=true

# Chave pública dummy oficial do Turnstile, exclusiva para desenvolvimento local.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
AUTH_CAPTCHA_ENABLED=true

# Parâmetros operacionais do smoke test; flags CLI podem sobrescrevê-los.
SMOKE_BASE_URL=http://localhost:3000
SMOKE_EXPECT_SIGNUP=enabled
SMOKE_TIMEOUT_MS=10000

## Asaas
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com
ASAAS_WEBHOOK_TOKEN=

# Instante único da campanha: bônus por 15 dias e preço de lançamento por 30 dias.
# Mantenha desativado até definir o início oficial com fuso horário explícito.
# LAUNCH_OFFER_START_AT=2026-10-20T09:00:00-03:00

## OpenAI
OPENAI_API_KEY=
OPENAI_REPORT_ASSISTANT_MODEL=gpt-6-luna
